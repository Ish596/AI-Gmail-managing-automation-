{
  "name": "ai email writer",
  "nodes": [
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview",
          "cachedResultName": "Gemini 3 Flash Preview",
          "cachedResultUrl": ""
        },
        "messages": {
          "values": [
            {
              "content": "=you are an helpful email assistant , you job is to read all upcoming email summarise them into 1 line sentence add see whether it need a reply or not if yes then generate a reply in polite and proffesional tone and make draft in html format so that it always ready to send .\n",
              "role": "model"
            },
            {
              "content": "=You are an AI email assistant.\n\nAnalyze the email provided below and return the following:\n\n1. Summarize the email in exactly one line.\n2. Determine whether the email requires a reply (Yes/No).\n3. If a reply is needed, draft a polite, professional, and contextually appropriate response.\n4. If no reply is needed, set the suggested reply to \"NA\".\n\nEmail:\n{{ $json.text }}\n\nReturn ONLY valid JSON in this exact structure:\n\n{\n  \"summary\": \"One-line summary of the email\",\n  \"reply needed\": \"Yes/No\",\n  \"suggested reply\": \"Professional reply or NA\"\n}\n\nRules:\n- Do not include Markdown or code fences.\n- Do not add explanations outside the JSON.\n- Never invent facts or commitments.\n- Keep replies concise, polite, and professional.\n- Return valid JSON only."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        224,
        224
      ],
      "id": "e7dabd8f-9e64-496c-b35c-98f3fc4d4e94",
      "name": "personal accont",
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst raw = $json.content.parts[0].text;\n\nconst parsed = JSON.parse(raw);\n\nreturn {\n  json: {\n    summary: parsed.summary,\n    reply_needed: parsed[\"reply needed\"],\n    suggested_reply: parsed[\"suggested reply\"]\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        224
